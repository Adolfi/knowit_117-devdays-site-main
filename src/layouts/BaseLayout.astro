---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · ${site.city}`,
  description = `${site.tagline} ${site.date}, ${site.city}.`,
} = Astro.props;

// Canonical/OG URL derived from the configured `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Event structured data (schema.org) for rich results.
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: site.name,
  description: site.intro,
  startDate: site.startISO,
  endDate: site.endISO,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  url: canonical,
  location: {
    '@type': 'Place',
    name: site.venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.venue.address,
      addressLocality: site.city,
      postalCode: site.venue.postalCode,
      addressCountry: 'SE',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.venue.lat,
      longitude: site.venue.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: site.host,
    url: site.hostUrl,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'SEK',
    availability: 'https://schema.org/InStock',
    url: site.luma.publicUrl || canonical,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Set the theme before paint to avoid a flash of the wrong colors. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="author" href="/humans.txt" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#ffffff" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} is:inline />

    <!-- Register the service worker (offline support + installability). -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Global paired particle clouds: a fixed, full-viewport backdrop that
         stays put while the content scroll-snaps over it. Fully procedural
         (no images). A CSS gradient covers first paint / reduced-motion. -->
    <div class="site-bg" aria-hidden="true">
      <canvas id="site-canvas" data-hero-canvas></canvas>
    </div>

    <slot />

    <!--
      Activate scroll snapping on the first user interaction. Enabling
      `scroll-snap-type` on the root scroller triggers a snap reflow that
      prevents Chrome from reporting Largest Contentful Paint. Waiting for real
      input means the metric is captured cleanly (Performance stays at 100)
      while users still get full-page snap scrolling from their first scroll.
    -->
    <script is:inline>
      (function () {
        var events = ['wheel', 'touchstart', 'keydown', 'pointerdown', 'scroll'];
        function enableSnap() {
          document.documentElement.classList.add('snap-ready');
          events.forEach(function (t) {
            window.removeEventListener(t, enableSnap);
          });
        }
        events.forEach(function (t) {
          window.addEventListener(t, enableSnap, { once: true, passive: true });
        });
      })();
    </script>

    <script>
      import '../scripts/entangled';
    </script>
  </body>
</html>

<style>
  /* Fixed, full-viewport animated backdrop behind all content. */
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* Colour pools also provide a complete backdrop without JavaScript. */
    background:
      radial-gradient(ellipse at 80% 28%, var(--field-violet-pool), transparent 55%),
      radial-gradient(ellipse at 62% 82%, var(--field-rose-pool), transparent 52%),
      radial-gradient(ellipse at 100% 70%, var(--field-blue-pool), transparent 48%);
  }

  #site-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: var(--field-opacity);
    /* Keep the left-hand copy quiet; let the particle detail emerge at the edges. */
    mask-image: linear-gradient(110deg, #0005, #0008 30%, #000 68%);
    -webkit-mask-image: linear-gradient(110deg, #0005, #0008 30%, #000 68%);
  }

  @media (max-width: 640px) {
    #site-canvas {
      mask-image: linear-gradient(180deg, #0003, #0006 55%, #000);
      -webkit-mask-image: linear-gradient(180deg, #0003, #0006 55%, #000);
    }
  }

  /* Accessible skip link — hidden until focused. */
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.9rem;
    background: var(--bg-elevated);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0.5rem;
  }
</style>
