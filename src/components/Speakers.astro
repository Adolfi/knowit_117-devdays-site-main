---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import RegisterCta from './RegisterCta.astro';

function initials(name: string): string {
  return name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<section id="speakers" class="section">
  <div class="container">
    <p class="eyebrow">{site.ui.speakers.eyebrow}</p>
    <h2>{site.ui.speakers.heading}</h2>
    <p class="lead">{site.ui.speakers.lead}</p>

    <div class="grid grid--3 speakers">
      {
        site.speakers.map((s) => {
          const people = [s, ...(s.coSpeakers ?? [])];
          return (
            <div class="card speaker">
              <div class="speaker__people">
                {people.map((p, i) => (
                  <div class="speaker__person" data-active={i === 0 ? 'true' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
                    {p.photo ? (
                      <Image
                        class="speaker__photo"
                        src={p.photo}
                        alt={`Portrait of ${p.name}`}
                        width={256}
                        height={256}
                        densities={[1, 2]}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="speaker__avatar" aria-hidden="true">{initials(p.name)}</div>
                    )}
                    <h3 class="speaker__name">{p.name}</h3>
                    <p class="speaker__role">{p.role}</p>
                    {p.bio && <p class="speaker__bio">{p.bio}</p>}
                  </div>
                ))}
              </div>
              {s.talk && (
                <div class="speaker__talk">
                  <p class="speaker__talk-label">{site.ui.speakers.talkLabel}</p>
                  <p class="speaker__talk-title">{s.talk.title}</p>
                  <p class="speaker__talk-desc">{s.talk.description}</p>
                </div>
              )}
              {people.some((p) => p.linkedin || p.github) && (
                <div class="speaker__socials">
                  {people.map((p, i) => (
                    <div
                      class="speaker__social-group"
                      data-active={i === 0 ? 'true' : undefined}
                      aria-hidden={i === 0 ? undefined : 'true'}
                    >
                      {p.linkedin && (
                        <a
                          class="speaker__social"
                          href={p.linkedin}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${p.name} on LinkedIn`}
                        >
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z" />
                          </svg>
                        </a>
                      )}
                      {p.github && (
                        <a
                          class="speaker__social"
                          href={p.github}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${p.name} on GitHub`}
                        >
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.26 3.4.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
                          </svg>
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <RegisterCta />
  </div>
</section>

<script>
  // Talks with more than one speaker cycle their photo/name/role/bio and
  // matching social icons every 5s, in lockstep, instead of cramming
  // multiple people into one card at once.
  function setInactive(el: HTMLElement) {
    el.removeAttribute('data-active');
    el.setAttribute('aria-hidden', 'true');
  }

  function setActive(el: HTMLElement) {
    el.setAttribute('data-active', 'true');
    el.removeAttribute('aria-hidden');
  }

  document.querySelectorAll<HTMLElement>('.speaker').forEach((card) => {
    const people = Array.from(card.querySelectorAll<HTMLElement>('.speaker__person'));
    if (people.length < 2) return;
    const socialGroups = Array.from(card.querySelectorAll<HTMLElement>('.speaker__social-group'));

    let active = 0;
    setInterval(() => {
      setInactive(people[active]);
      if (socialGroups[active]) setInactive(socialGroups[active]);

      active = (active + 1) % people.length;

      setActive(people[active]);
      if (socialGroups[active]) setActive(socialGroups[active]);
    }, 5000);
  });
</script>

<style>
  .speakers {
    margin-top: 2rem;
  }

  .speaker {
    text-align: center;
  }

  /* On the 3-up layout, use subgrid so every row (the people block, each
     line of the talk block, and the social icons) lines up across all
     three cards. */
  @media (min-width: 860px) {
    .speakers {
      column-gap: 1.5rem;
      row-gap: 0;
      grid-template-rows: repeat(5, auto);
    }

    .speaker {
      grid-row: 1 / span 5;
      display: grid;
      grid-template-rows: subgrid;
      align-content: start;
    }

    .speaker__talk {
      grid-row: span 3;
      display: grid;
      grid-template-rows: subgrid;
      align-content: start;
    }

    /* Pin the icons to the bottom row so they align across cards. */
    .speaker__socials {
      grid-row: 5;
      align-self: end;
    }
  }

  /* Each speaker (or co-speaker) gets their own photo + name + role block.
     With one person it just sits there; with more than one, the blocks are
     stacked on top of each other and cross-fade every few seconds instead
     of cramming multiple portraits into one card (see the script below). */
  .speaker__people {
    position: relative;
    margin-bottom: 1rem;
  }

  .speaker__person {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .speaker__people:has(> :nth-child(2)) .speaker__person {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  .speaker__people:has(> :nth-child(2)) .speaker__person[data-active] {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .speaker__people:has(> :nth-child(2)) .speaker__person {
      transition: opacity 0.6s ease;
    }
  }

  .speaker__avatar {
    width: 64px;
    height: 64px;
    margin: 0 0 0.9rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-contrast);
    background: var(--gradient);
  }

  .speaker__photo {
    width: 168px;
    height: 168px;
    margin: 0 0 1rem;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-muted);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .speaker__name {
    margin: 0 0 0.1rem;
  }

  .speaker__role {
    margin: 0 0 0.5rem;
    color: var(--accent-text);
    font-size: 0.92rem;
  }

  .speaker__bio {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .speaker__talk {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-muted);
    text-align: left;
  }

  .speaker__talk-label {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .speaker__talk-title {
    margin: 0 0 0.35rem;
    font-weight: 650;
  }

  .speaker__talk-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Mirrors .speaker__people: one social-icon group per person, stacked and
     cross-faded in lockstep with the active speaker (see the script above). */
  .speaker__socials {
    position: relative;
    margin-top: 1.1rem;
  }

  .speaker__social-group {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .speaker__socials:has(> :nth-child(2)) {
    /* Reserve space for the icons even if whichever person is active has
       none, so the absolutely-positioned groups don't collapse to 0 height. */
    min-height: 2.3rem;
  }

  .speaker__socials:has(> :nth-child(2)) .speaker__social-group {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  .speaker__socials:has(> :nth-child(2)) .speaker__social-group[data-active] {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .speaker__socials:has(> :nth-child(2)) .speaker__social-group {
      transition: opacity 0.6s ease;
    }
  }

  .speaker__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.12s ease;
  }

  .speaker__social:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
  }

  .speaker__social svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }
</style>
