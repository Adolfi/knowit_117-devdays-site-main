---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · ${site.city}`,
  description = `${site.tagline} ${site.date}, ${site.city}.`,
} = Astro.props;

// Canonical/OG URL derived from the configured `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Event structured data (schema.org) for rich results.
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: site.name,
  description: site.intro,
  startDate: site.startISO,
  endDate: site.endISO,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  url: canonical,
  location: {
    '@type': 'Place',
    name: site.venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.venue.address,
      addressLocality: site.city,
      postalCode: site.venue.postalCode,
      addressCountry: 'SE',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.venue.lat,
      longitude: site.venue.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: site.host,
    url: site.hostUrl,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'SEK',
    availability: 'https://schema.org/InStock',
    url: site.luma.publicUrl || canonical,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Set the theme before paint to avoid a flash of the wrong colors. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="author" href="/humans.txt" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0d1117" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} is:inline />

    <!-- Register the service worker (offline support + installability). -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Global animated "entangled" field: a fixed, full-viewport backdrop that
         stays put while the content scroll-snaps over it. Fully procedural
         (no images). A CSS gradient covers first paint / reduced-motion. -->
    <div class="site-bg" aria-hidden="true">
      <canvas id="site-canvas" data-hero-canvas></canvas>
    </div>

    <slot />

    <!--
      Activate scroll snapping on the first user interaction. Enabling
      `scroll-snap-type` on the root scroller triggers a snap reflow that
      prevents Chrome from reporting Largest Contentful Paint. Waiting for real
      input means the metric is captured cleanly (Performance stays at 100)
      while users still get full-page snap scrolling from their first scroll.
    -->
    <script is:inline>
      (function () {
        var events = ['wheel', 'touchstart', 'keydown', 'pointerdown', 'scroll'];
        function enableSnap() {
          document.documentElement.classList.add('snap-ready');
          events.forEach(function (t) {
            window.removeEventListener(t, enableSnap);
          });
        }
        events.forEach(function (t) {
          window.addEventListener(t, enableSnap, { once: true, passive: true });
        });
      })();
    </script>

    <script>
      // "Entangled" — a fixed, full-viewport field of two counter-rotating
      // particle vortices driven by a smooth flow field, drawn as fine fading
      // filaments whose hue slowly drifts. Procedural (no images). Deferred to
      // load and paused while the tab is hidden so it never affects LCP/TBT.
      interface Pt {
        x: number; y: number; px: number; py: number;
        vx: number; vy: number; life: number; max: number;
        home: 0 | 1; bright: number; pal: number;
      }

      function initField() {
        const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
        if (!canvas) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduce.matches) return; // CSS fallback gradient shown instead
        const ctx = canvas.getContext('2d', { alpha: true });
        if (!ctx) return;

        let w = 0, h = 0, dpr = 1;
        let pts: Pt[] = [];
        let base = '13, 17, 23';
        let dark = true;

        const readTheme = () => {
          const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d1117';
          const rgb = hexToRgb(bg);
          base = rgb.join(', ');
          dark = 0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2] < 128;
        };
        function hexToRgb(hex: string): [number, number, number] {
          const m = hex.replace('#', '');
          const v = m.length === 3 ? m.split('').map((c) => c + c).join('') : m;
          const n = parseInt(v, 16);
          return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
        }
        const rand = (a: number, b: number) => a + Math.random() * (b - a);

        // A quiet palette that leans on the brand pink/purple/blue but sneaks
        // in a teal and a rare warm amber for depth. Weights keep the accents
        // subtle so nothing dominates. Hues drift a little over time.
        const PAL = [330, 300, 262, 222, 190, 34];
        const PAL_W = [30, 20, 28, 18, 10, 5];
        const palBag: number[] = [];
        PAL_W.forEach((wgt, i) => { for (let k = 0; k < wgt; k++) palBag.push(i); });
        const pickPal = () => palBag[(Math.random() * palBag.length) | 0];

        const angleAt = (x: number, y: number, t: number) => {
          const s = 0.0019;
          return (
            (Math.sin(x * s + Math.cos(y * s * 0.9) + t * 0.15) +
              Math.cos(y * s * 1.1 - Math.sin(x * s * 0.8) + t * 0.12)) *
            Math.PI
          );
        };

        let cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;
        const spawn = (p: Pt, home: 0 | 1) => {
          const cx = home === 0 ? cx0 : cx1;
          const cy = home === 0 ? cy0 : cy1;
          const a = rand(0, Math.PI * 2);
          const r = Math.pow(Math.random(), 0.6) * Math.max(w, h) * 0.2;
          p.x = p.px = cx + Math.cos(a) * r;
          p.y = p.py = cy + Math.sin(a) * r;
          p.vx = rand(-0.3, 0.3);
          p.vy = rand(-0.3, 0.3);
          p.home = home;
          p.max = rand(140, 520);
          p.life = p.max;
          p.bright = Math.random() < 0.1 ? 1 : 0;
          p.pal = pickPal();
        };

        const build = () => {
          w = Math.max(1, window.innerWidth);
          h = Math.max(1, window.innerHeight);
          dpr = Math.min(window.devicePixelRatio || 1, 1.75);
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          readTheme();
          cx0 = w * 0.4; cy0 = h * 0.5; cx1 = w * 0.6; cy1 = h * 0.5;
          const count = Math.round(Math.min(1700, Math.max(500, (w * h) / 1350)));
          pts = new Array(count);
          for (let i = 0; i < count; i++) {
            const p = {} as Pt;
            spawn(p, i % 2 === 0 ? 0 : 1);
            pts[i] = p;
          }
          fillBase();
        };

        const fillBase = () => {
          ctx.globalCompositeOperation = 'source-over';
          ctx.fillStyle = `rgb(${base})`;
          ctx.fillRect(0, 0, w, h);
        };

        const draw = (now: number) => {
          const t = now * 0.001;
          const minWH = Math.min(w, h);
          const maxWH = Math.max(w, h);

          // Two vortices orbit their midpoint and breathe apart/together,
          // spread wide across the viewport.
          const sep = maxWH * (0.16 + 0.09 * (0.5 + 0.5 * Math.cos(t * 0.14)));
          const rot = t * 0.05;
          const mx = w * 0.5 + Math.sin(t * 0.08) * w * 0.05;
          const my = h * 0.5 + Math.sin(t * 0.12) * h * 0.05;
          cx0 = mx - Math.cos(rot) * sep;
          cy0 = my - Math.sin(rot) * sep * 0.55;
          cx1 = mx + Math.cos(rot) * sep;
          cy1 = my + Math.sin(rot) * sep * 0.55;

          // Trail fade toward the field colour.
          ctx.globalCompositeOperation = 'source-over';
          ctx.fillStyle = `rgba(${base}, ${dark ? 0.034 : 0.05})`;
          ctx.fillRect(0, 0, w, h);

          // Per-palette lightness/saturation; brights carry a touch more hue
          // (slightly lower lightness) so colour still reads while density
          // still blooms toward white in the additive dark-mode pass.
          const sat = dark ? 85 : 60;
          const li = dark ? 56 : 28;
          const liB = dark ? 68 : 22;

          const nPal = PAL.length;
          const dim: Path2D[] = new Array(nPal);
          const bri: Path2D[] = new Array(nPal);
          for (let k = 0; k < nPal; k++) { dim[k] = new Path2D(); bri[k] = new Path2D(); }

          const bound = maxWH * 0.78;
          for (let i = 0; i < pts.length; i++) {
            const p = pts[i];
            const d0x = cx0 - p.x, d0y = cy0 - p.y;
            const d1x = cx1 - p.x, d1y = cy1 - p.y;
            const near0 = d0x * d0x + d0y * d0y < d1x * d1x + d1y * d1y;
            const dx = near0 ? d0x : d1x;
            const dy = near0 ? d0y : d1y;
            const sign = near0 ? 1 : -1;
            const inv = 1 / (Math.hypot(dx, dy) + 26);
            p.vx += dx * inv * 0.05 - dy * inv * 0.1 * sign;
            p.vy += dy * inv * 0.05 + dx * inv * 0.1 * sign;
            const a = angleAt(p.x, p.y, t);
            p.vx += Math.cos(a) * 0.13;
            p.vy += Math.sin(a) * 0.13;
            p.vx *= 0.9;
            p.vy *= 0.9;
            p.px = p.x; p.py = p.y;
            p.x += p.vx; p.y += p.vy;

            const path = (p.bright ? bri : dim)[p.pal];
            path.moveTo(p.px, p.py);
            path.lineTo(p.x, p.y);

            p.life--;
            const ex = p.x - mx, ey = p.y - my;
            if (p.life <= 0 || ex * ex + ey * ey > bound * bound) {
              spawn(p, Math.random() < 0.5 ? 0 : 1);
            }
          }

          ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';
          ctx.lineWidth = 0.8;
          const aDim = dark ? 0.34 : 0.22;
          const aBri = dark ? 0.85 : 0.6;
          for (let k = 0; k < nPal; k++) {
            const hue = PAL[k] + Math.sin(t * 0.05 + k * 1.3) * 10;
            ctx.strokeStyle = `hsla(${hue}, ${sat}%, ${li}%, ${aDim})`;
            ctx.stroke(dim[k]);
          }
          for (let k = 0; k < nPal; k++) {
            const hue = PAL[k] + Math.sin(t * 0.05 + k * 1.3) * 10;
            ctx.strokeStyle = `hsla(${hue}, ${sat}%, ${liB}%, ${aBri})`;
            ctx.stroke(bri[k]);
          }

          raf = requestAnimationFrame(draw);
        };

        let raf = 0;
        let running = false;
        const start = () => {
          if (running || document.hidden) return;
          running = true;
          fillBase();
          raf = requestAnimationFrame(draw);
        };
        const stop = () => {
          running = false;
          cancelAnimationFrame(raf);
        };

        build();
        start();

        let resizeRaf = 0;
        window.addEventListener('resize', () => {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(build);
        });
        document.addEventListener('visibilitychange', () => {
          document.hidden ? stop() : start();
        });
        new MutationObserver(() => {
          readTheme();
          fillBase();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        reduce.addEventListener?.('change', (e) => {
          if (e.matches) {
            stop();
            ctx.clearRect(0, 0, w, h);
          } else {
            start();
          }
        });
      }

      if (document.readyState === 'complete') {
        requestAnimationFrame(initField);
      } else {
        window.addEventListener('load', () => requestAnimationFrame(initField), { once: true });
      }
    </script>
  </body>
</html>

<style>
  /* Fixed, full-viewport animated backdrop behind all content. */
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* Fallback / pre-JS / reduced-motion: a faint two-lobe glow. */
    background:
      radial-gradient(40% 52% at 36% 40%, color-mix(in srgb, var(--orb-glow) 60%, transparent), transparent 72%),
      radial-gradient(44% 56% at 66% 62%, color-mix(in srgb, var(--link) 26%, transparent), transparent 74%);
  }

  #site-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Accessible skip link — hidden until focused. */
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.9rem;
    background: var(--bg-elevated);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0.5rem;
  }
</style>
