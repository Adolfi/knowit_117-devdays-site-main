---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import RegisterCta from './RegisterCta.astro';

function initials(name: string): string {
  return name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

// Co-presenters share the exact same `talk` object reference in site.ts, so
// group consecutive speakers into one card when they reference it. Each
// group renders one card with a profile block per speaker but a single
// shared Talk section.
const groups: (typeof site.speakers)[] = [];
for (const s of site.speakers) {
  const prevGroup = groups[groups.length - 1];
  if (prevGroup && s.talk && prevGroup[0].talk === s.talk) {
    prevGroup.push(s);
  } else {
    groups.push([s]);
  }
}

// Force a line break whenever a group wouldn't fit in the remaining space of
// a 3-unit-wide row (a duo card takes 2 units), so a trailing partial row
// always wraps onto its own line instead of depending on flex-basis math.
let rowWidth = 0;
const rows = groups.map((group) => {
  const width = group.length;
  const breakBefore = rowWidth > 0 && rowWidth + width > 3;
  rowWidth = breakBefore ? width : rowWidth + width;
  return { group, breakBefore, width };
});
---

<section id="speakers" class="section">
  <div class="container">
    <p class="eyebrow">{site.ui.speakers.eyebrow}</p>
    <h2>{site.ui.speakers.heading}</h2>
    <p class="lead">{site.ui.speakers.lead}</p>

    <div class="grid grid--3 speakers">
      {
        rows.map(({ group, breakBefore, width }) => (
          <>
          {/* Force a line break when a group wouldn't fit the remaining row
              width so a trailing partial row always wraps onto its own
              line, instead of depending on flex-basis math (which can flash
              wrong before styles settle). */}
          {breakBefore && <div class="speakers__break" aria-hidden="true" />}
          <div class:list={['card', 'speaker', width > 1 && `speaker--span-${width}`]}>
            <div class="speaker__profiles">
              {group.map((s) => (
                <div class="speaker__profile">
                  {s.photo ? (
                    <Image
                      class="speaker__photo"
                      src={s.photo}
                      alt={`Portrait of ${s.name}`}
                      width={256}
                      height={256}
                      densities={[1, 2]}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="speaker__avatar" aria-hidden="true">{initials(s.name)}</div>
                  )}
                  <h3 class="speaker__name">{s.name}</h3>
                  <p class="speaker__role">{s.role}</p>
                  {s.bio && <p class="speaker__bio">{s.bio}</p>}
                </div>
              ))}
            </div>
            {group[0].talk && (
              <div class="speaker__talk">
                <p class="speaker__talk-label">{site.ui.speakers.talkLabel}</p>
                <p class="speaker__talk-title">{group[0].talk.title}</p>
                <p class="speaker__talk-desc">{group[0].talk.description}</p>
              </div>
            )}
            {group.some((s) => s.linkedin || s.github) && (
              <div class="speaker__socials">
                {group.map((s) => (
                  <>
                    {s.linkedin && (
                      <a
                        class="speaker__social"
                        href={s.linkedin}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${s.name} on LinkedIn`}
                      >
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z" />
                        </svg>
                      </a>
                    )}
                    {s.github && (
                      <a
                        class="speaker__social"
                        href={s.github}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${s.name} on GitHub`}
                      >
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                          <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.26 3.4.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
                        </svg>
                      </a>
                    )}
                  </>
                ))}
              </div>
            )}
          </div>
          </>
        ))
      }
    </div>

    <RegisterCta />
  </div>
</section>

<style>
  /* Override the shared 3-column grid with flex-wrap so a trailing partial
     row (e.g. 2 leftover cards out of 5) centers instead of hugging the
     left edge. */
  .speakers {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .speaker {
    text-align: center;
    flex: 1 1 100%;
    /* Column layout so the socials row can be pinned to the bottom via
       margin-top: auto, keeping the LinkedIn/GitHub icons aligned across
       cards regardless of how much bio/talk text each one has. */
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    .speaker {
      flex: 0 1 calc((100% - 2 * 1.25rem) / 3);
    }

    /* A duo card (co-presenters sharing one talk) spans 2 of the 3 columns,
       i.e. 2 card widths plus the gap between them. */
    .speaker--span-2 {
      flex: 0 1 calc((100% - 2 * 1.25rem) / 3 * 2 + 1.25rem);
    }
  }

  /* Belt-and-suspenders: force a new line after every 3rd card so the grid
     can never render as a single squeezed row, regardless of flex-basis
     rounding or styles settling late. */
  .speakers__break {
    flex-basis: 100%;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
  }

  .speaker__profiles {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Duo cards show each co-presenter's profile side by side on wider
     screens; a divider between them echoes the gap that used to separate
     their two standalone cards. */
  @media (min-width: 640px) {
    .speaker--span-2 .speaker__profiles {
      flex-direction: row;
    }

    .speaker--span-2 .speaker__profile {
      flex: 1 1 0;
      padding-inline: 0.5rem;
    }

    .speaker--span-2 .speaker__profile + .speaker__profile {
      border-left: 1px solid var(--border-muted);
    }
  }

  .speaker__avatar {
    width: 64px;
    height: 64px;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-contrast);
    background: var(--gradient);
  }

  .speaker__photo {
    width: 168px;
    height: 168px;
    margin: 0 auto 1rem;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-muted);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .speaker__name {
    margin: 0 0 0.1rem;
  }

  .speaker__role {
    margin: 0 0 0.5rem;
    color: var(--accent-text);
    font-size: 0.92rem;
  }

  .speaker__bio {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .speaker__talk {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-muted);
    text-align: left;
  }

  .speaker__talk-label {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .speaker__talk-title {
    margin: 0 0 0.35rem;
    font-weight: 650;
  }

  .speaker__talk-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .speaker__socials {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    /* Pinned to the card's bottom (see .speaker) so icons line up across
       cards; padding-top keeps a minimum gap when there's no slack above. */
    margin-top: auto;
    padding-top: 1.1rem;
  }

  .speaker__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.12s ease;
  }

  .speaker__social:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
  }

  .speaker__social svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }
</style>
