---
import { site } from '../config/site';
import RegisterCta from './RegisterCta.astro';
---

<section id="agenda" class="section section--alt">
  <div class="container">
    <p class="eyebrow">{site.ui.agenda.eyebrow}</p>
    <h2>{site.ui.agenda.heading}</h2>
    <p class="lead">{site.ui.agenda.lead}</p>

    <ol class="agenda">
      {
        site.agenda.map((item) => (
          <li class="agenda__row">
            <span class="agenda__time">{item.time}</span>
            <div class="agenda__body">
              <h3 class="agenda__title">
                {item.title}
                {item.speaker && (
                  <>
                    {' — '}
                    <a
                      class="agenda__speaker"
                      href={item.speaker.url}
                      target="_blank"
                      rel="noopener"
                    >
                      {item.speaker.name}
                    </a>
                  </>
                )}
              </h3>
              <p class="agenda__desc">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <RegisterCta />
  </div>
</section>

<style>
  .agenda {
    list-style: none;
    counter-reset: none;
    padding: 0;
    margin: 2rem 0 0;
  }

  .agenda__row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border-muted);
  }

  .agenda__row:last-child {
    border-bottom: 1px solid var(--border-muted);
  }

  .agenda__time {
    font-family: var(--font-mono);
    font-weight: 650;
    color: var(--accent-text);
    padding-top: 0.15rem;
  }

  .agenda__title {
    margin: 0 0 0.15rem;
  }

  .agenda__speaker {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .agenda__speaker:hover {
    text-decoration: none;
  }

  .agenda__desc {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 520px) {
    .agenda__row {
      grid-template-columns: 4rem 1fr;
    }
  }
</style>
